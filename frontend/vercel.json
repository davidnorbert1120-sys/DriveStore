{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/drivestore-frontend/browser",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://drivestore-api.onrender.com/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://drivestore-api.onrender.com/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
